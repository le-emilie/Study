//Verificar se dois numeros são amigos

#include <stdio.h>

// Função que calcula a soma dos divisores próprios de um número
int soma_divisores_proprios(int numero) {
    int soma = 0;
    int i;

    for (i = 1; i < numero; i++) {
        if (numero % i == 0) {
            soma += i;
        }
    }

    return soma;
}

int sao_amigos(int a, int b) {  // Função que verifica se dois números são amigos
    int soma_a = soma_divisores_proprios(a);
    int soma_b = soma_divisores_proprios(b);

    if (soma_a == b && soma_b == a) {
        return 1; // São amigos
    } else {
        return 0; // Não são amigos
    }
}

int main() {
    int num1, num2;

    // Leitura dos números
    printf("Digite o primeiro numero inteiro positivo: ");
    scanf("%d", &num1);

    printf("Digite o segundo numero inteiro positivo: ");
    scanf("%d", &num2);

    // Verifica e exibe o resultado
    if (sao_amigos(num1, num2)) {
        printf("Os numeros %d e %d sao numeros amigos.\n", num1, num2);
    } else {
        printf("Os numeros %d e %d NAO sao numeros amigos.\n", num1, num2);
    }

    return 0;
}
